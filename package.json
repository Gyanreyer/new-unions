{
  "name": "new-unions",
  "version": "1.0.0",
  "description": "New Unions Website",
  "homepage": "https://newunionsbridal.com",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "serve": "wrangler pages dev _site --port 8080",
    "watch": "npx @11ty/eleventy --config=eleventy.config.ts --watch",
    "dev": "concurrently \"npm run watch\" \"npm run serve\"",
    "build": "npx @11ty/eleventy --config=eleventy.config.ts"
  },
  "dependencies": {
    "@11ty/eleventy": "^3.1.5",
    "sharp": "^0.34.5",
    "yeti-js": "^0.0.7-alpha.3"
  },
  "devDependencies": {
    "concurrently": "^10.0.6",
    "esbuild": "^0.28.0",
    "lightningcss": "^1.32.0",
    "marked": "^18.0.0",
    "wrangler": "^4.83.0"
  }
}